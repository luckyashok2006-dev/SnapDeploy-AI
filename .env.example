# =============================================================================
# SnapDeploy AI Production & Runtime Environment Configuration
# =============================================================================

# Server Network & Host Binding
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# AI Provider Configuration
# IMPORTANT: GEMINI_API_KEY is server-side only and never exposed to the client.
# In production (NODE_ENV=production):
# - If unconfigured/absent, AI generation and editing endpoints return HTTP 503 (GEMINI_PROVIDER_UNAVAILABLE).
# - Production mock providers remain strictly disabled (Phase 8.1 Step 5 safety contract; no mock fallback in production).
# - Application readiness probe /api/health/readiness reports HTTP 503 GEMINI_PROVIDER_UNCONFIGURED (Phase 8.1 Step 8 contract).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Reverse Proxy Trust Configuration (Phase 8.1 Step 7)
# Options: 'loopback' (local reverse proxy), '1' (single upstream hop e.g. ingress/ALB), or CIDR subnet
TRUST_PROXY=1

# CORS Security (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Graceful Shutdown & Drain Deadlines (in milliseconds, Phase 8.1 Steps 9 & 13)
SHUTDOWN_TIMEOUT_MS=25000
FATAL_SHUTDOWN_TIMEOUT_MS=5000

# Content Security Policy (CSP, Phase 8.1 Steps 11 & 11A)
CSP_ENABLED=true
CSP_REPORT_ONLY=false
# Optional CSP report URI (leave empty unless an external collector is configured)
CSP_REPORT_URI=
# Optional extra connect-src origins (space-separated)
CSP_ADDITIONAL_CONNECT_SRC=
